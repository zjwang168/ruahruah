# Copy to .env.local and fill in. .env.local is gitignored — never commit real values.
# Ask the founder for these directly (1Password / Signal); don't paste them anywhere public.

# Supabase — hosted project. Both of these ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — BYPASSES RLS. Server-only: never import into a 'use client' file.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — /api/chat, /api/contact, /api/ai-followup
ANTHROPIC_API_KEY=

# Bearer token the Vercel cron presents to /api/ai-followup; also how you invoke it by hand.
CRON_SECRET=

# Public origin, used for absolute share-card URLs (og:image, og:url).
# Production is https://ruahruah.com; set your own for a preview deploy.
NEXT_PUBLIC_SITE_URL=
