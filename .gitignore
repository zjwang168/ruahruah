# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# editors — IDE settings are per-developer, not per-project. The ruahruah
# fork had .idea/ committed by accident; this keeps it from happening again.
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.env.local
# claude code
.claude/settings.local.json
.claude/worktrees/

# Google OAuth client downloads — never in git. One was swept in by `git add -A`
# on 2026-09-14 and caught by push protection.
client_secret_*.json
*.apps.googleusercontent.com.json
